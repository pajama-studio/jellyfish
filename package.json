{
  "name": "@pajama-studio/jellyfish",
  "version": "0.1.0",
  "description": "A real-time 3D jellyfish soft-body × fluid simulation on WebGPU (three.js TSL). Open source at jellyfish.rand.monster.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --config \"$PWD/wrangler.jsonc\""
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
